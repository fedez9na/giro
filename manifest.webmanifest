{
  "name": "Giro",
  "short_name": "Giro",
  "description": "La giornata dal foglio dei turni",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f3f5",
  "theme_color": "#1b4f9c",
  "icons": [
    { "src": "icona-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icona-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icona-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "foglio", "accept": ["application/pdf", ".pdf"] }] }
  }
}
